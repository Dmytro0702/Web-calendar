{
  "hosting": {
    "public": "client/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.@(css|js|svg|png|jpg|jpeg|gif|webp|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "europe-west2" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "server",
    "runtime": "nodejs20",
    "region": "europe-west2"
  }
}
