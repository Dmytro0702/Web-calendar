{
  "name": "calendar-dev-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "engines": { "node": "20" },
  "scripts": {
    "dev": "cross-env START_SERVER=true PORT=4000 nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "cross-env START_SERVER=true node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.12",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^1.6.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
